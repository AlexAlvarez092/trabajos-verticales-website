---
import { getTranslations, type Locale } from '../i18n';
import { company } from '../i18n/company';

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const t = getTranslations(locale);
const waText = encodeURIComponent(t.contact.whatsappText);
---

<section id="contact" class="section">
  <div class="container contact__inner">
    <h2>{t.contact.title}</h2>
    <p class="contact__intro">{t.contact.intro}</p>

    <div class="contact__actions">
      <a class="btn btn--primary" href={`tel:${company.phoneIntl}`}>
        <svg aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M22 16.9v3a2 2 0 0 1-2.2 2 19.8 19.8 0 0 1-8.6-3 19.5 19.5 0 0 1-6-6 19.8 19.8 0 0 1-3-8.6A2 2 0 0 1 4.1 2h3a2 2 0 0 1 2 1.7c.1.9.3 1.8.6 2.6a2 2 0 0 1-.5 2.1L8.1 9.9a16 16 0 0 0 6 6l1.5-1.1a2 2 0 0 1 2.1-.5c.8.3 1.7.5 2.6.6a2 2 0 0 1 1.7 2z"/></svg>
        {t.contact.call}: {company.phone}
      </a>

      <a class="btn btn--primary" href={`https://wa.me/${company.whatsappNumber}?text=${waText}`} target="_blank" rel="noopener">
        <svg aria-hidden="true" viewBox="0 0 24 24" fill="currentColor"><path d="M12 2a10 10 0 0 0-8.5 15.3L2 22l4.8-1.5A10 10 0 1 0 12 2zm0 18a8 8 0 0 1-4.1-1.1l-.3-.2-2.8.9.9-2.7-.2-.3A8 8 0 1 1 12 20zm4.4-6c-.2-.1-1.4-.7-1.6-.8-.2-.1-.4-.1-.5.1l-.7.9c-.1.2-.3.2-.5.1a6.5 6.5 0 0 1-3.2-2.8c-.2-.4.2-.4.6-1.1.1-.1 0-.3 0-.4l-.8-1.8c-.2-.5-.4-.4-.5-.4h-.5a1 1 0 0 0-.7.3A3 3 0 0 0 6.5 9c0 1.8 1.3 3.5 1.5 3.7.2.2 2.6 4 6.3 5.3 2.2.8 2.5.5 3 .5s1.4-.6 1.6-1.1c.2-.6.2-1 .1-1.1l-.6-.3z"/></svg>
        {t.contact.whatsapp}
      </a>

      <a class="btn btn--outline" href={`mailto:${company.email}`}>
        <svg aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="5" width="18" height="14" rx="2"/><path d="m3 7 9 6 9-6"/></svg>
        {t.contact.email}
      </a>
      <a class="btn btn--outline" href={company.instagram} target="_blank" rel="noopener noreferrer">
        <svg aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="3" width="18" height="18" rx="5"/><circle cx="12" cy="12" r="4"/><path d="M17.5 6.5h.01"/></svg>
        {t.contact.instagram}
      </a>
    </div>
  </div>
</section>

<style>
  .contact__inner {
    text-align: center;
    display: grid;
    justify-items: center;
    gap: 1rem;
  }
  .contact__intro {
    max-width: 50ch;
    color: color-mix(in srgb, var(--color-white) 85%, transparent);
  }
  .contact__actions {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 1rem;
    margin-top: 1.5rem;
  }
  .contact__actions .btn svg {
    width: 1.2rem;
    height: 1.2rem;
  }
</style>
