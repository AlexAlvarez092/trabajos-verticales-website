---
import { getTranslations, type Locale } from '../i18n';
import { company } from '../i18n/company';

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const t = getTranslations(locale);
const waText = encodeURIComponent(t.contact.whatsappText);
---

<a
  class="wa-float"
  href={`https://wa.me/${company.whatsappNumber}?text=${waText}`}
  target="_blank"
  rel="noopener"
  aria-label={t.contact.whatsapp}
>
  <svg aria-hidden="true" viewBox="0 0 24 24" fill="currentColor">
    <path d="M12 2a10 10 0 0 0-8.5 15.3L2 22l4.8-1.5A10 10 0 1 0 12 2zm0 18a8 8 0 0 1-4.1-1.1l-.3-.2-2.8.9.9-2.7-.2-.3A8 8 0 1 1 12 20zm4.4-6c-.2-.1-1.4-.7-1.6-.8-.2-.1-.4-.1-.5.1l-.7.9c-.1.2-.3.2-.5.1a6.5 6.5 0 0 1-3.2-2.8c-.2-.4.2-.4.6-1.1.1-.1 0-.3 0-.4l-.8-1.8c-.2-.5-.4-.4-.5-.4h-.5a1 1 0 0 0-.7.3A3 3 0 0 0 6.5 9c0 1.8 1.3 3.5 1.5 3.7.2.2 2.6 4 6.3 5.3 2.2.8 2.5.5 3 .5s1.4-.6 1.6-1.1c.2-.6.2-1 .1-1.1l-.6-.3z"/>
  </svg>
</a>

<style>
  .wa-float {
    position: fixed;
    right: 1.1rem;
    bottom: 1.1rem;
    z-index: 200;
    width: 3.5rem;
    height: 3.5rem;
    display: grid;
    place-items: center;
    border-radius: 50%;
    background: var(--color-lime);
    color: var(--color-black);
    box-shadow: 0 4px 14px rgba(0, 0, 0, 0.4);
    transition: background-color 0.2s ease, transform 0.15s ease;
  }
  .wa-float:hover {
    background: var(--color-lime-dark);
    transform: translateY(-2px);
  }
  .wa-float svg {
    width: 2rem;
    height: 2rem;
  }
</style>
