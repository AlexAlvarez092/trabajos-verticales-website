---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import { getTranslations, type Locale } from '../i18n';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = getTranslations(locale);
const photos = Object.entries(import.meta.glob<ImageMetadata>(
  '../../assets/pictures/*.webp',
  { eager: true, import: 'default' },
)).sort(([a], [b]) => a.localeCompare(b, undefined, { numeric: true }));
---

<section class="section gallery" aria-labelledby="gallery-title">
  <div class="container">
    <work-gallery>
      <div class="gallery__heading">
        <h2 id="gallery-title">{t.gallery.title}</h2>
        <div class="gallery__controls" hidden>
          <button type="button" data-previous aria-label={t.gallery.previous} aria-controls="work-photos">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="m14 6-6 6 6 6" /></svg>
          </button>
          <button type="button" data-next aria-label={t.gallery.next} aria-controls="work-photos">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="m10 6 6 6-6 6" /></svg>
          </button>
        </div>
      </div>
      <ul id="work-photos" class="gallery__track" tabindex="0" aria-label={t.gallery.title}>
        {photos.map(([path, photo]) => {
          const key = path.split('/').pop()?.replace('.webp', '');
          const alt = t.gallery.photos.find((item) => item.key === key)?.alt;
          if (!alt) throw new Error(`Missing gallery description: ${path} (${locale})`);
          return (
            <li class="gallery__slide">
              <Image
                src={photo}
                alt={alt}
                width={Math.min(960, photo.width)}
                widths={[320, 640, Math.min(960, photo.width)]}
                sizes="(min-width: 1000px) 360px, (min-width: 640px) 45vw, 90vw"
                format="webp"
                quality={78}
                loading="lazy"
                decoding="async"
              />
            </li>
          );
        })}
      </ul>
    </work-gallery>
  </div>
</section>

<script>
  class WorkGallery extends HTMLElement {
    connectedCallback() {
      const track = this.querySelector<HTMLUListElement>('.gallery__track');
      const previous = this.querySelector<HTMLButtonElement>('[data-previous]');
      const next = this.querySelector<HTMLButtonElement>('[data-next]');
      const controls = this.querySelector<HTMLDivElement>('.gallery__controls');
      if (!track || !previous || !next || !controls) return;

      const update = () => {
        previous.disabled = track.scrollLeft <= 1;
        next.disabled = track.scrollLeft + track.clientWidth >= track.scrollWidth - 1;
      };
      const move = (direction: number) => {
        const slide = track.querySelector<HTMLElement>('.gallery__slide');
        if (!slide) return;
        const gap = parseFloat(getComputedStyle(track).columnGap);
        track.scrollBy({ left: direction * (slide.offsetWidth + gap) });
      };

      previous.addEventListener('click', () => move(-1));
      next.addEventListener('click', () => move(1));
      track.addEventListener('scroll', update, { passive: true });
      track.addEventListener('keydown', (event) => {
        if (event.key === 'ArrowLeft' || event.key === 'ArrowRight') {
          event.preventDefault();
          move(event.key === 'ArrowLeft' ? -1 : 1);
        } else if (event.key === 'Home' || event.key === 'End') {
          event.preventDefault();
          track.scrollTo({ left: event.key === 'Home' ? 0 : track.scrollWidth });
        }
      });
      const observer = new ResizeObserver(update);
      observer.observe(track);
      this.cleanup = () => observer.disconnect();
      controls.hidden = false;
      update();
    }

    private cleanup?: () => void;

    disconnectedCallback() {
      this.cleanup?.();
    }
  }

  customElements.define('work-gallery', WorkGallery);
</script>

<style>
  .gallery {
    padding-bottom: clamp(2rem, 4vw, 3rem);
  }
  work-gallery {
    display: block;
  }
  .gallery__heading {
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 1rem;
    margin-bottom: 1.5rem;
  }
  .gallery__controls:not([hidden]) {
    display: flex;
    gap: 0.5rem;
  }
  .gallery__controls button {
    display: grid;
    place-items: center;
    width: 2.75rem;
    height: 2.75rem;
    border: 1px solid var(--color-lime);
    border-radius: 50%;
    background: transparent;
    color: var(--color-lime);
    cursor: pointer;
  }
  .gallery__controls button:hover:not(:disabled) {
    background: var(--color-lime);
    color: var(--color-black);
  }
  .gallery__controls button:disabled {
    opacity: 0.35;
    cursor: default;
  }
  .gallery__controls svg {
    width: 1.5rem;
    height: 1.5rem;
  }
  .gallery__track {
    display: flex;
    gap: 1rem;
    overflow-x: auto;
    overscroll-behavior-x: contain;
    scroll-snap-type: x mandatory;
    scroll-behavior: smooth;
    scrollbar-color: var(--color-lime) var(--color-gray);
    scrollbar-width: thin;
    padding-bottom: 1rem;
    list-style: none;
  }
  .gallery__slide {
    flex: 0 0 90%;
    min-width: 0;
    aspect-ratio: 3 / 4;
    scroll-snap-align: start;
    overflow: hidden;
    border: 1px solid var(--color-gray);
    border-radius: var(--radius);
    background: var(--color-gray);
  }
  .gallery__slide img {
    width: 100%;
    height: 100%;
    object-fit: contain;
  }
  @media (min-width: 640px) {
    .gallery__slide {
      flex-basis: calc((100% - 1rem) / 2);
    }
  }
  @media (min-width: 1000px) {
    .gallery__slide {
      flex-basis: calc((100% - 2rem) / 3);
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .gallery__track {
      scroll-behavior: auto;
    }
  }
</style>
